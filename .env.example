# Copy to .env and fill in your Supabase project values.
SUPABASE_URL=https://your-project.supabase.co
# Server: service role key recommended. Fallback: SUPABASE_KEY (anon).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_KEY=your-anon-or-service-role-key

# Optional: Postgres URI for scripts
# SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.YOUR_REF.supabase.co:5432/postgres

MODEL_PATH=runs/detect/train-5/weights/best.pt
CONFIDENCE_THRESHOLD=0.6
COOLDOWN_SECONDS=5
PRINT_INTERVAL_SECONDS=2
WEBCAM_INDEX=0

# API security / ops
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
EXPIRY_WARNING_DAYS=3
MAX_UPLOAD_BYTES=5242880
REQUIRE_AUTH=false

# SKIP_WEBCAM=1
