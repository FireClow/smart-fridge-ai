# Copy to .env (never commit .env)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_KEY=your-publishable-or-anon-key
# Leave empty in dev to use Vite proxy → FastAPI (:8001 local, :8000 Replit).
# Replit deploy: leave empty — same origin serves /api + SPA.
# Vercel-only frontend: set to external API host (Render, Railway, etc.).
VITE_API_URL=
